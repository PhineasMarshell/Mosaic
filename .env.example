# Mosaic — Environment Configuration Template

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Market Gateway Mode ---
# "mcp" or "http"
MARKET_GATEWAY_MODE=http

# --- MCP Mode ---
MCP_COMMAND=iiix
MCP_ARGS=mcp serve market-gateway

# --- HTTP Mode ---
MARKET_GATEWAY_HTTP_URL=https://api.x.iiix.dev/v1/d/market-gateway
MARKET_GATEWAY_API_KEY=your_market_gateway_api_key_here

# --- Performance Limits ---
MAX_TOOL_CALLS=12
MAX_RESEARCH_STEPS=8
MAX_RETRY_PER_TOOL=1
RESEARCH_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=90

# Mosaic — Environment Configuration Template

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Market Gateway Mode ---
# "mcp" or "http"
MARKET_GATEWAY_MODE=http
# A 股研究主数据源；MCP 只在主源 error/empty/unsupported 且仍有预算时备用
MARKET_PRIMARY_SOURCE=ths_skill
MARKET_FALLBACK_SOURCE=mcp
MARKET_SOURCE_FALLBACK_ENABLED=true
MARKET_SOURCE_ROUTING_ENABLED=true

# --- MCP Mode ---
# 需要 iiix CLI >= 0.8.0：旧语法 `mcp serve <project-code>` 已在 0.8.0 删除，
# 新语法为 `plugin serve <project-code>`。MCP_COMMAND 指向 iiix 可执行文件。
MCP_COMMAND=iiix
MCP_ARGS=plugin serve market-gateway
# Writable root used only by the spawned iiix process; iiix writes
# <MCP_APPDATA_DIR>/iiix/logs/iiix.log. Empty defaults to .tmp/iiix-appdata.
MCP_APPDATA_DIR=
# Optional installed-plugin root, independent of the log root. Empty inherits LOCALAPPDATA.
MCP_LOCALAPPDATA_DIR=

# --- Gateway 启动自检（mcp 模式） ---
# 启动时做一次 spawn + 握手 + list_tools 自检；失败不阻塞启动（warn），
# 但记 ERROR 日志并在 /health 的 gateway_channel 标记 mcp_unavailable。
# 置 fail 则启动即终止。排查见 docs/gateway_troubleshooting.md。
GATEWAY_STARTUP_SELFCHECK=true
GATEWAY_SELFCHECK_ON_FAILURE=warn

# --- HTTP Mode ---
MARKET_GATEWAY_HTTP_URL=https://api.x.iiix.dev/v1/d/market-gateway
MARKET_GATEWAY_API_KEY=your_market_gateway_api_key_here

# --- Performance Limits ---
MAX_TOOL_CALLS=12
MAX_RESEARCH_STEPS=8
# research_more 回环轮最多代码级补齐几个 Critic 点名的缺口工具
GAP_MAX_STEPS=3
MAX_RETRY_PER_TOOL=1
# Independent calls overlap inside each analyst; all share the tools deadline.
TOOL_CONCURRENCY=3
TOOLS_PHASE_TIMEOUT_SECONDS=45
# 单次工具调用 / MCP 握手超时
RESEARCH_TIMEOUT_SECONDS=30
# 一次完整调查（planner + N 个工具 + reasoning）的总预算。
# 必须显著大于 RESEARCH_TIMEOUT_SECONDS，否则 HTTP 层会在研究跑完前掐断它。
# 接受范围 1..86400 s
RESEARCH_BUDGET_SECONDS=300
GRAPH_RECURSION_LIMIT=25
# SSE 静默期心跳间隔，防止浏览器/代理掐掉长时间无事件的连接
STREAM_HEARTBEAT_SECONDS=15
LLM_TIMEOUT_SECONDS=90
# Maximum completion size for planner/reasoning/critic JSON responses
LLM_MAX_COMPLETION_TOKENS=2048
# SQLite 写事务等待锁释放的时间，以及持久化锁冲突的有限重试
SQLITE_BUSY_TIMEOUT_MS=5000       # 0..30000 ms
PERSISTENCE_MAX_RETRIES=2         # 0..5 次额外重试
PERSISTENCE_RETRY_BACKOFF_MS=25   # 0..1000 ms，指数递增

# --- SEC EDGAR (US Fundamentals) ---
# SEC 公平访问政策要求所有请求声明访问身份，格式: YourName your@email.com
# 留空 = 美股基本面工具（us_fundamentals / us_filings_recent）不发起网络请求、直接返回错误
SEC_EDGAR_CONTACT=YourName your@email.com

# --- 同花顺问财官方 Skill API ---
# 可选；缺少 key 时问财工具返回错误，其余工具照常使用。不需要运行时安装 SkillHub CLI。
IWENCAI_BASE_URL=https://openapi.iwencai.com
IWENCAI_INDEX_TTL_SECONDS=60
IWENCAI_ASTOCK_SELECTOR_TTL_SECONDS=60
IWENCAI_SECTOR_SELECTOR_TTL_SECONDS=60
IWENCAI_BUSINESS_TTL_SECONDS=3600
IWENCAI_INSRESEARCH_TTL_SECONDS=3600
IWENCAI_API_KEY=
# 公告检索缓存秒数，0 关闭缓存
IWENCAI_ANNOUNCEMENT_TTL_SECONDS=900
IWENCAI_FINANCE_TTL_SECONDS=3600
IWENCAI_EVENT_TTL_SECONDS=900
IWENCAI_BASICINFO_TTL_SECONDS=86400
IWENCAI_MARKET_TTL_SECONDS=60
IWENCAI_MACRO_TTL_SECONDS=3600
IWENCAI_INDUSTRY_TTL_SECONDS=60
IWENCAI_MANAGEMENT_TTL_SECONDS=3600
IWENCAI_REPORT_TTL_SECONDS=3600
IWENCAI_NEWS_TTL_SECONDS=300

# --- News (多源新闻聚合) ---
# 新闻分析员总开关（打开后 NewsAnalyst 上线，news 类工具进入路由候选）
NEWS_ENABLED=false
# news_search 的 TTL 分档（秒）：time_limit=d（今天）/w（本周）/m（本月）
NEWS_TTL_DAY_SECONDS=1800
NEWS_TTL_WEEK_SECONDS=21600
NEWS_TTL_MONTH_SECONDS=86400
# internal_symbol_news（东财个股新闻+Google 资讯）缓存时长
NEWS_SYMBOL_TTL_SECONDS=900
# internal_market_telegraph（财联社电报快讯，变化快）
NEWS_TELEGRAPH_TTL_SECONDS=300
# internal_news_digest（Google 资讯+DDGS 主题聚合）缓存时长
NEWS_DIGEST_TTL_SECONDS=900
# 全A code↔name 名称表缓存（首载实测约 5-6s，长 TTL 摊销）
NEWS_CODE_NAME_TTL_SECONDS=86400
# 单条新闻正文进 datum 的截断长度（字符）
NEWS_MAX_TEXT_CHARS=800
# 单个新闻源（Google RSS / 东财 / 电报）的抓取超时（秒）
NEWS_SOURCE_TIMEOUT_SECONDS=15

+        if decisions and not any(_field(row, "decision", "") == "kept" for row in decisions):
+            return "no_executable_gap_steps"
+        return "research_budget_exhausted"
+    if verdict == "revise":
+        return "rewrite_budget_exhausted"
+    if verdict == "error" or not verdict:
+        return "audit_error"
